

# --- Gemini (Google AI Studio) ---
# Obtenla en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Gmail API (OAuth2) ---
# Ruta al archivo de credenciales descargado desde Google Cloud Console
GMAIL_CREDENTIALS_PATH=credentials.json
# Ruta donde se guardará el token generado tras el primer login OAuth
GMAIL_TOKEN_PATH=token.json

# --- Base de datos ---
DATABASE_URL=sqlite:///./data/organizador.db

# --- App / entorno ---
APP_ENV=development
LOG_LEVEL=INFO